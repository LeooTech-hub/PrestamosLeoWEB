# PrestamosLeoWEB - Database Configuration (Turso / LibSQL / SQLite)

# Option A: Local SQLite database (Default if DATABASE_URL is not set)
DATABASE_URL="file:local.db"

# Option B: Turso Cloud / LibSQL Serverless Database (For Vercel Deployment)
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
